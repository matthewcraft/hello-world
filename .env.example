# Server
PORT=8080
PUBLIC_BASE_URL=https://your-public-domain.example

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VOICE_NUMBER=+15555555555
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=verse

# Trello
TRELLO_KEY=your_trello_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=xxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_LIST_TOCALL_ID=xxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_LIST_INPROGRESS_ID=xxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_LIST_DONE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Agent defaults
AGENT_SYSTEM_PROMPT=You are a helpful phone agent. Be concise and polite.
MAX_CONCURRENT_CALLS=2